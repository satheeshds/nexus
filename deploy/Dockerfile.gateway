# syntax=docker/dockerfile:1.7
FROM golang:1.26-bookworm AS builder

ARG COMMIT_SHA=unknown

WORKDIR /app

# Install DuckDB build dependencies (required for CGO)
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends \
    gcc g++ cmake ca-certificates

COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod,sharing=locked \
    go mod download

COPY cmd/gateway ./cmd/gateway
COPY internal ./internal

RUN --mount=type=cache,target=/go/pkg/mod,sharing=locked \
    --mount=type=cache,target=/root/.cache/go-build,sharing=locked \
    CGO_ENABLED=1 GOOS=linux go build \
    -ldflags="-s -w" \
    -o /bin/nexus-gateway \
    ./cmd/gateway

# ── Runtime ───────────────────────────────────────────────────────────────────
FROM debian:bookworm-slim

ARG COMMIT_SHA=unknown


RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates libstdc++6

LABEL watchlog.commit-sha="${COMMIT_SHA}"
LABEL watchlog.monitor="true"
LABEL watchlog.service="nexus-gateway"
LABEL watchlog.project-repo="satheeshds/nexus"

COPY --from=builder /bin/nexus-gateway /usr/local/bin/nexus-gateway

EXPOSE 5433

ENTRYPOINT ["nexus-gateway"]
