# syntax=docker/dockerfile:1.7
FROM golang:1.26-bookworm AS builder

ARG COMMIT_SHA=unknown

WORKDIR /app

# Install DuckDB build dependencies (required for CGO in tenant provisioner)
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends \
    gcc g++ cmake ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod,sharing=locked \
    go mod download

COPY cmd/control ./cmd/control
# Swagger docs are committed to the repo; copy them instead of regenerating.
COPY docs ./docs
COPY internal ./internal
COPY migrations ./migrations

RUN --mount=type=cache,target=/go/pkg/mod,sharing=locked \
    --mount=type=cache,target=/root/.cache/go-build,sharing=locked \
    CGO_ENABLED=1 GOOS=linux go build \
    -ldflags="-s -w" \
    -o /bin/nexus-control \
    ./cmd/control

# ── Runtime ───────────────────────────────────────────────────────────────────
FROM debian:bookworm-slim

ARG COMMIT_SHA=unknown

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl libstdc++6 \
    && rm -rf /var/lib/apt/lists/*

LABEL watchlog.commit-sha="${COMMIT_SHA}"
LABEL watchlog.monitor="true"
LABEL watchlog.service="nexus-control"
LABEL watchlog.project-repo="satheeshds/nexus"

COPY --from=builder /bin/nexus-control /usr/local/bin/nexus-control

EXPOSE 8080

ENTRYPOINT ["nexus-control"]
